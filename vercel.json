{
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "cd backend && poetry install"
      }
    },
    {
      "src": "frontend/next.config.ts",
      "use": "@vercel/next",
      "config": {
        "workPath": "frontend"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}