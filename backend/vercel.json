{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": { "installCommand": "pip install -r requirements.txt" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "functions": {
    "backend/main.py": {
      "excludeFiles": [
        "**/.chromadb/**",
        "**/tests/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**"
      ]
    }
  }
}