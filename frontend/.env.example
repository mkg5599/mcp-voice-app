# Required: Gemini API key (free tier works). Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the FastAPI backend (and its MCP endpoint at /mcp) is reachable from this server
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-lite-latest
# AGENT_MAX_STEPS=5
# GEMINI_BASE_URL=            # proxy or local mock; leave unset for Google's API
# GEMINI_THINKING_LEVEL=low       # minimal | low | medium | high; empty = model default
# Rate limits as max/windowSeconds ("0/1" disables). Per visitor IP, and site-wide per server instance.
# RATE_LIMIT_CHAT=20/600
# RATE_LIMIT_CHAT_GLOBAL=300/3600
# RATE_LIMIT_TRANSCRIBE=15/600
# RATE_LIMIT_TRANSCRIBE_GLOBAL=200/3600
